<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>500 · Server Error</title>

  <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css" />

  <style>
    body {
      background-color: #020f16;
      color: #e5e7eb;
    }

    .error-code {
      font-size: 6rem;
      font-weight: 700;
      letter-spacing: 2px;
      color: #f87171;
    }

    .error-text {
      color: #9ca3af;
      max-width: 420px;
      margin: 0 auto;
    }

    .btn-outline-danger {
      border-color: #f87171;
      color: #f87171;
    }

    .btn-outline-danger:hover {
      background-color: #f87171;
      color: #020f16;
    }
  </style>
</head>

<body class="d-flex align-items-center justify-content-center vh-100">
  <div class="text-center px-3">
    <div class="error-code mb-2">500</div>

    <p class="fs-5 mb-1">Something went wrong</p>
    <p class="error-text mb-4">
      It’s not you — it’s us.  
      Our server ran into an issue while processing your request.
    </p>

    <a href="/admin" class="btn btn-outline-danger px-4">
      Try again
    </a>
  </div>
</body>
</html>