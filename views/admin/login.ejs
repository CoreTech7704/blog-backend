<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>Admin</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css" />

    <style>
      body {
        background-color: #020f16;
      }

      .form-control::placeholder {
        color: #aaa;
      }

      .form-control:focus {
        box-shadow: 0 0 0 0.2rem rgba(45, 121, 243, 0.25);
      }

      .admin-card {
        border: 1px solid rgba(13, 110, 253, 0.35); /* bootstrap primary */
        box-shadow:
          0 0 0 1px rgba(13, 110, 253, 0.15),
          0 20px 40px rgba(0, 0, 0, 0.6);
      }
    </style>
  </head>

  <body class="bg-dark">
    <main class="d-flex align-items-center justify-content-center vh-100">
      <div
        class="card shadow-lg border-0 text-light"
        style="width: 420px; border-radius: 20px"
      >
        <div
          class="card-body admin-card p-4"
          style="
            border-radius: 20px;
            background-color: #1f1f1f;
            border: 2px solid rgb(15, 137, 236);
          "
        >
          <!-- Title -->
          <h3 class="text-center text-primary fw-semibold mb-4">Admin Login</h3>

          <form action="/admin/login" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <!-- Email -->
            <div class="mb-3">
              <label class="form-label">Email</label>
              <div class="input-group">
                <span class="input-group-text bg-secondary border-0">
                  <!-- email icon -->
                  @
                </span>
                <input
                  type="email"
                  name="email"
                  class="form-control bg-dark text-light border-secondary"
                  placeholder="Enter your email"
                  required
                />
              </div>
            </div>

            <!-- Password -->
            <div class="mb-3">
              <label class="form-label">Password</label>
              <div class="input-group">
                <span class="input-group-text bg-secondary border-0"> 🔒 </span>
                <input
                  type="password"
                  name="password"
                  class="form-control bg-dark text-light border-secondary"
                  placeholder="Enter your password"
                  required
                />
              </div>
            </div>

            <!-- Forgot -->
            <div class="text-end mb-3">
              <a href="#" class="small text-primary text-decoration-none">
                Forgot password?
              </a>
            </div>

            <!-- Button -->
            <button type="submit" class="btn btn-primary w-100 py-2">
              Sign In
            </button>
          </form>
        </div>
      </div>
    </main>

    <script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
