<section class="mb-4">
  <h2 class="fw-semibold text-info mb-1">Blog Moderation</h2>
  <p class="text-soft">
    Publish, draft, feature, or remove blog posts
  </p>
</section>

<div class="admin-panel panel-surface p-3">
  <!-- Top Controls -->
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <input
      type="text"
      class="form-control w-50"
      placeholder="Search by title or author"
    />

    <select class="form-select w-auto">
      <option value="">Status: All</option>
      <option value="published">Published</option>
      <option value="draft">Draft</option>
    </select>
  </div>

  <!-- Blogs Table -->
  <div class="table-responsive">
    <table class="table table-dark table-hover align-middle text-light">
      <thead>
        <tr>
          <th>#</th>
          <th>Title</th>
          <th>Author</th>
          <th>Category</th>
          <th>Status</th>
          <th>Featured</th>
          <th>Views</th>
          <th>Created</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>

      <tbody>
        <!-- Sample Row -->
        <tr>
          <td>1</td>
          <td>How AI Is Changing Web Development</td>
          <td>john_doe</td>
          <td>Technology</td>

          <td>
            <span class="badge bg-success">Published</span>
          </td>

          <td>
            <span class="badge bg-success">Yes</span>
          </td>

          <td>1,248</td>
          <td>12 Feb 2026</td>

          <td class="text-end">
            <button class="btn btn-sm btn-outline-warning">
              Draft
            </button>
            <button class="btn btn-sm btn-outline-info">
              Unfeature
            </button>
            <button class="btn btn-sm btn-outline-danger">
              Delete
            </button>
          </td>
        </tr>

        <tr>
          <td>2</td>
          <td>Why Dark Mode Improves UX</td>
          <td>alice_w</td>
          <td>Design</td>

          <td>
            <span class="badge bg-secondary">Draft</span>
          </td>

          <td>
            <span class="badge bg-secondary">No</span>
          </td>

          <td>112</td>
          <td>10 Feb 2026</td>

          <td class="text-end">
            <button class="btn btn-sm btn-outline-success">
              Publish
            </button>
            <button class="btn btn-sm btn-outline-info">
              Feature
            </button>
            <button class="btn btn-sm btn-outline-danger">
              Delete
            </button>
          </td>
        </tr>

        <tr>
          <td>3</td>
          <td>Scaling Node.js Applications</td>
          <td>dev_sam</td>
          <td>Backend</td>

          <td>
            <span class="badge bg-success">Published</span>
          </td>

          <td>
            <span class="badge bg-secondary">No</span>
          </td>

          <td>824</td>
          <td>05 Feb 2026</td>

          <td class="text-end">
            <button class="btn btn-sm btn-outline-warning">
              Draft
            </button>
            <button class="btn btn-sm btn-outline-info">
              Feature
            </button>
            <button class="btn btn-sm btn-outline-danger">
              Delete
            </button>
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- Pagination -->
  <nav class="d-flex justify-content-end mt-3">
    <ul class="pagination pagination-sm mb-0">
      <li class="page-item disabled">
        <span class="page-link">Prev</span>
      </li>
      <li class="page-item active">
        <span class="page-link">1</span>
      </li>
      <li class="page-item">
        <span class="page-link">2</span>
      </li>
      <li class="page-item">
        <span class="page-link">Next</span>
      </li>
    </ul>
  </nav>
</div>