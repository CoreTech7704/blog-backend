<section class="mb-4">
  <h2 class="fw-semibold text-info mb-1">Blog Moderation</h2>
  <p class="text-soft">
    Publish, draft, feature, or remove blog posts
  </p>
</section>

<div class="admin-panel panel-surface p-3">
  <!-- Top Controls -->
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <input
      type="text"
      class="form-control w-50"
      placeholder="Search by title or author"
    />

    <select class="form-select w-auto">
      <option value="">Status: All</option>
      <option value="published">Published</option>
      <option value="draft">Draft</option>
    </select>
  </div>

  <!-- Blogs Table -->
  <div class="table-responsive">
    <table class="table table-dark table-hover align-middle text-light">
      <thead>
        <tr>
          <th>#</th>
          <th>Title</th>
          <th>Author</th>
          <th>Category</th>
          <th>Status</th>
          <th>Featured</th>
          <th>Views</th>
          <th>Created</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>

      <tbody>
        <% blogs.forEach((blog, index) => { %>
          <tr>
            <td><%= index + 1 %></td>

            <td><%= blog.title %></td>
            <td><%= blog.author?.username || "—" %></td>
            <td><%= blog.category?.name || "—" %></td>

            <td>
              <% if (blog.status === "published") { %>
                <span class="badge bg-success">Published</span>
              <% } else { %>
                <span class="badge bg-secondary">Draft</span>
              <% } %>
            </td>

            <td>
              <% if (blog.featured) { %>
                <span class="badge bg-success">Yes</span>
              <% } else { %>
                <span class="badge bg-secondary">No</span>
              <% } %>
            </td>

            <td><%= blog.views %></td>

            <td>
              <%= new Date(blog.createdAt).toLocaleDateString() %>
            </td>

            <td class="text-end d-flex gap-1 justify-content-end">
              <!-- Publish / Draft -->
              <form
                method="POST"
                action="/admin/blogs/<%= blog._id %>/toggle-status"
              >
                <% if (blog.status === "published") { %>
                  <button class="btn btn-sm btn-outline-warning">
                    Draft
                  </button>
                <% } else { %>
                  <button class="btn btn-sm btn-outline-success">
                    Publish
                  </button>
                <% } %>
              </form>

              <!-- Feature -->
              <form
                method="POST"
                action="/admin/blogs/<%= blog._id %>/toggle-featured"
              >
                <button class="btn btn-sm btn-outline-info">
                  <%= blog.featured ? "Unfeature" : "Feature" %>
                </button>
              </form>

              <!-- Delete -->
              <form
                method="POST"
                action="/admin/blogs/<%= blog._id %>/delete"
                onsubmit="return confirm('Delete this blog?')"
              >
                <button class="btn btn-sm btn-outline-danger">
                  Delete
                </button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- Pagination -->
  <nav class="d-flex justify-content-end mt-3">
    <ul class="pagination pagination-sm mb-0">
      <li class="page-item disabled">
        <span class="page-link">Prev</span>
      </li>
      <li class="page-item active">
        <span class="page-link">1</span>
      </li>
      <li class="page-item">
        <span class="page-link">2</span>
      </li>
      <li class="page-item">
        <span class="page-link">Next</span>
      </li>
    </ul>
  </nav>
</div>