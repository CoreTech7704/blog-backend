<section class="mb-4">
  <h2 class="fw-semibold text-info mb-1">Blog Moderation</h2>
  <p class="text-soft">
    Publish, draft, feature, or remove blog posts
  </p>
</section>

<div class="admin-panel panel-surface p-3">
  <!-- Top Controls -->
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <form method="GET" action="/admin/blogs" class="d-flex gap-2">
      <input
        type="text"
        name="q"
        class="form-control"
        placeholder="Search by title or author"
        value="<%= query?.q || '' %>"
      />

      <select name="status" class="form-select w-auto">
        <option value="">Status: All</option>
        <option value="published" <%= query?.status === 'published' ? 'selected' : '' %>>Published</option>
        <option value="draft" <%= query?.status === 'draft' ? 'selected' : '' %>>Draft</option>
      </select>

      <button class="btn btn-outline-info">Filter</button>
    </form>
  </div>

  <!-- Blogs Table -->
  <div class="table-responsive">
    <table class="table table-dark table-hover align-middle text-light">
      <thead>
        <tr>
          <th>#</th>
          <th>Title</th>
          <th>Author</th>
          <th>Category</th>
          <th>Status</th>
          <th>Featured</th>
          <th>Views</th>
          <th>Created</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>

      <tbody>
        <% blogs.forEach((blog, index) => { %>
          <tr>
            <td><%= index + 1 %></td>

            <td><%= blog.title %></td>
            <td><%= blog.author?.username || "—" %></td>
            <td><%= blog.category?.name || "—" %></td>

            <td>
              <% if (blog.status === "published") { %>
                <span class="badge bg-success">Published</span>
              <% } else { %>
                <span class="badge bg-secondary">Draft</span>
              <% } %>
            </td>

            <td>
              <% if (blog.featured) { %>
                <span class="badge bg-success">Yes</span>
              <% } else { %>
                <span class="badge bg-secondary">No</span>
              <% } %>
            </td>

            <td><%= blog.views %></td>

            <td>
              <%= new Date(blog.createdAt).toLocaleDateString() %>
            </td>

            <td class="text-end p-2">
              <div class="action-grid">

                <!-- Publish / Draft -->
                <form
                  method="POST"
                  action="/admin/blogs/<%= blog._id %>/toggle-status"
                >
                  <% if (blog.status === "published") { %>
                    <button class="btn btn-sm btn-outline-warning w-100">
                      Draft
                    </button>
                  <% } else { %>
                    <button class="btn btn-sm btn-outline-success w-100">
                      Publish
                    </button>
                  <% } %>
                </form>

                <!-- Feature -->
                <form
                  method="POST"
                  action="/admin/blogs/<%= blog._id %>/toggle-featured"
                >
                  <button class="btn btn-sm btn-outline-info w-100">
                    <%= blog.featured ? "Unfeature" : "Feature" %>
                  </button>
                </form>

                <!-- View -->
                <button
                  class="btn btn-sm btn-outline-info"
                  data-bs-toggle="modal"
                  data-bs-target="#view-<%= blog._id %>"
                >
                  View
                </button>

                <!-- Delete -->
                <form
                  method="POST"
                  action="/admin/blogs/<%= blog._id %>/delete"
                  onsubmit="return confirm('Delete this blog?')"
                >
                  <button class="btn btn-sm btn-outline-danger w-100">
                    Delete
                  </button>
                </form>

              </div>
            </td>
          </tr>

          <!-- View Modal -->
          <div
            class="modal fade"
            id="view-<%= blog._id %>"
            tabindex="-1"
            aria-hidden="true"
          >
            <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
              <div class="modal-content bg-dark text-light border border-secondary">

                <!-- Header -->
                <div class="modal-header border-secondary">
                  <h5 class="modal-title">
                    <%= blog.title %>
                  </h5>
                  <button
                    type="button"
                    class="btn-close btn-close-white"
                    data-bs-dismiss="modal"
                  ></button>
                </div>

                <!-- Body -->
                <div class="modal-body">

                  <!-- Meta Info -->
                  <div class="mb-3 text-soft small">
                    <span>Author: <strong><%= blog.author?.username || "—" %></strong></span>
                    &nbsp;•&nbsp;
                    <span>Category: <strong><%= blog.category?.name || "—" %></strong></span>
                    &nbsp;•&nbsp;
                    <span>Status:
                      <strong class="<%= blog.status === 'published' ? 'text-success' : 'text-warning' %>">
                        <%= blog.status %>
                      </strong>
                    </span>
                  </div>

                  <hr class="border-secondary">

                  <!-- Blog Content -->
                  <div class="blog-preview-content">
                    <%- blog.content %>
                  </div>

                </div>

                <!-- Footer -->
                <div class="modal-footer border-secondary">
                  <button
                    type="button"
                    class="btn btn-sm btn-outline-secondary"
                    data-bs-dismiss="modal"
                  >
                    Close
                  </button>
                </div>

              </div>
            </div>
          </div>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- Pagination -->
  <nav class="d-flex justify-content-end mt-3">
    <ul class="pagination pagination-sm mb-0">
      <li class="page-item disabled">
        <span class="page-link">Prev</span>
      </li>
      <li class="page-item active">
        <span class="page-link">1</span>
      </li>
      <li class="page-item">
        <span class="page-link">2</span>
      </li>
      <li class="page-item">
        <span class="page-link">Next</span>
      </li>
    </ul>
  </nav>
</div>

