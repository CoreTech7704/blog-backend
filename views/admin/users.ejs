<section class="mb-4">
  <h2 class="fw-semibold text-info mb-1">User Management</h2>
  <p class="text-soft">
    View and manage registered platform users
  </p>
</section>

<div class="admin-panel panel-surface p-3">
  <!-- Search -->
  <div class="d-flex justify-content-between align-items-center mb-3">
    <input
      type="text"
      class="form-control w-50"
      placeholder="Search by name, username, or email"
    />
  </div>

  <!-- Users Table -->
  <div class="table-responsive">
    <table class="table table-dark table-hover align-middle text-light">
      <thead>
        <tr>
          <th>#</th>
          <th>Full Name</th>
          <th>Username</th>
          <th>Email</th>
          <th>Role</th>
          <th>Author</th>
          <th>Status</th>
          <th>Joined</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>

      <tbody>
        <!-- Sample Row -->
        <tr>
          <td>1</td>
          <td>John Doe</td>
          <td>john_doe</td>
          <td>john@example.com</td>

          <td>
            <span class="badge bg-primary">User</span>
          </td>

          <td>
            <span class="badge bg-secondary">No</span>
          </td>

          <td>
            <span class="badge bg-success">Active</span>
          </td>

          <td>12 Feb 2026</td>

          <td class="text-end">
            <button class="btn btn-sm btn-outline-info">
              View
            </button>
            <button class="btn btn-sm btn-outline-warning">
              Deactivate
            </button>
          </td>
        </tr>

        <tr>
          <td>2</td>
          <td>Alice Walker</td>
          <td>alice_w</td>
          <td>alice@example.com</td>

          <td>
            <span class="badge bg-primary">User</span>
          </td>

          <td>
            <span class="badge bg-success">Yes</span>
          </td>

          <td>
            <span class="badge bg-success">Active</span>
          </td>

          <td>09 Feb 2026</td>

          <td class="text-end">
            <button class="btn btn-sm btn-outline-info">
              View
            </button>
            <button class="btn btn-sm btn-outline-warning">
              Deactivate
            </button>
          </td>
        </tr>

        <tr>
          <td>3</td>
          <td>Mark Brown</td>
          <td>mark_b</td>
          <td>mark@example.com</td>

          <td>
            <span class="badge bg-danger">Admin</span>
          </td>

          <td>
            <span class="badge bg-secondary">No</span>
          </td>

          <td>
            <span class="badge bg-secondary">Inactive</span>
          </td>

          <td>01 Feb 2026</td>

          <td class="text-end">
            <button class="btn btn-sm btn-outline-info">
              View
            </button>
            <button class="btn btn-sm btn-outline-success">
              Activate
            </button>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>