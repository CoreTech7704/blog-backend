<section class="mb-4">
  <h2 class="fw-semibold text-info mb-1">Platform Analysis</h2>
  <p class="text-soft">
    Application health, data growth, and system connectivity
  </p>
</section>

<!-- Top Stats -->
<div class="row g-3 mb-4">
  <div class="col-xl-3 col-md-6">
    <div class="admin-stat-card">
      <div class="stat-label">Application Status</div>
      <div class="stat-value text-success">Running</div>
      <div class="stat-meta">Server is online</div>
    </div>
  </div>

  <div class="col-xl-3 col-md-6">
    <div class="admin-stat-card">
      <div class="stat-label">Database</div>
      <div class="stat-value text-success">Connected</div>
      <div class="stat-meta">MongoDB</div>
    </div>
  </div>

  <div class="col-xl-3 col-md-6">
    <div class="admin-stat-card">
      <div class="stat-label">Cache</div>
      <div class="stat-value text-success">Healthy</div>
      <div class="stat-meta">Redis</div>
    </div>
  </div>

  <div class="col-xl-3 col-md-6">
    <div class="admin-stat-card">
      <div class="stat-label">Data Records</div>
      <div class="stat-value">Growing</div>
      <div class="stat-meta">Users · Blogs · Comments</div>
    </div>
  </div>
</div>

<!-- System Panels -->
<div class="row g-3">
  <!-- System Health -->
  <div class="col-lg-6">
    <div class="admin-panel panel-surface">
      <h5 class="panel-title">System Health</h5>

      <ul class="list-group list-group-flush text-light">
        <li class="list-group-item bg-transparent d-flex justify-content-between">
          <span>API Server</span>
          <span class="text-success">Online</span>
        </li>

        <li class="list-group-item bg-transparent d-flex justify-content-between">
          <span>MongoDB</span>
          <span class="text-success">Connected</span>
        </li>

        <li class="list-group-item bg-transparent d-flex justify-content-between">
          <span>Redis Cache</span>
          <span class="text-success">Connected</span>
        </li>

        <li class="list-group-item bg-transparent d-flex justify-content-between">
          <span>Contact Cleanup</span>
          <span class="text-info">TTL Enabled</span>
        </li>

        <li class="list-group-item bg-transparent d-flex justify-content-between">
          <span>Background Jobs</span>
          <span class="text-success">Running</span>
        </li>
      </ul>
    </div>
  </div>

  <!-- Activity Summary -->
  <div class="col-lg-6">
    <div class="admin-panel panel-surface">
      <h5 class="panel-title">Platform Summary</h5>

      <ul class="activity-list">
        <li>
          <span class="dot green"></span>
          New users registered recently
          <span class="time">Last 24h</span>
        </li>
        <li>
          <span class="dot blue"></span>
          Blogs published steadily
          <span class="time">This week</span>
        </li>
        <li>
          <span class="dot orange"></span>
          Draft blogs pending review
          <span class="time">Ongoing</span>
        </li>
        <li>
          <span class="dot red"></span>
          Unread contact messages
          <span class="time">Attention needed</span>
        </li>
      </ul>
    </div>
  </div>
</div>

<!-- Future Metrics -->
<div class="admin-panel panel-surface mt-4">
  <h5 class="panel-title">Usage Trends</h5>
  <div class="text-muted text-center py-5">
    📊 Analytics & trends will appear here in future updates
  </div>
</div>