<section class="mb-4">
  <h2 class="fw-semibold mb-1">Platform Analysis</h2>
  <p class="text-muted">
    Monitor system health, activity, and platform performance
  </p>
</section>

<!-- Top Stats -->
<div class="row g-3 mb-4">
  <div class="col-xl-3 col-md-6">
    <div class="admin-stat-card">
      <div class="stat-label">Server Status</div>
      <div class="stat-value text-success">Online</div>
      <div class="stat-meta">Uptime: 99.98%</div>
    </div>
  </div>

  <div class="col-xl-3 col-md-6">
    <div class="admin-stat-card">
      <div class="stat-label">Active Users</div>
      <div class="stat-value">412</div>
      <div class="stat-meta">Last 24 hours</div>
    </div>
  </div>

  <div class="col-xl-3 col-md-6">
    <div class="admin-stat-card">
      <div class="stat-label">Requests / Min</div>
      <div class="stat-value">1,248</div>
      <div class="stat-meta">Avg traffic</div>
    </div>
  </div>

  <div class="col-xl-3 col-md-6">
    <div class="admin-stat-card">
      <div class="stat-label">Error Rate</div>
      <div class="stat-value text-warning">0.12%</div>
      <div class="stat-meta">Last hour</div>
    </div>
  </div>
</div>

<!-- System Panels -->
<div class="row g-3">
  <!-- Server Health -->
  <div class="col-lg-6">
    <div class="admin-panel">
      <h5 class="panel-title">Server Health</h5>

      <ul class="list-group list-group-flush text-light">
        <li class="list-group-item bg-transparent d-flex justify-content-between">
          <span>CPU Usage</span>
          <span class="text-warning">68%</span>
        </li>
        <li class="list-group-item bg-transparent d-flex justify-content-between">
          <span>Memory Usage</span>
          <span class="text-success">54%</span>
        </li>
        <li class="list-group-item bg-transparent d-flex justify-content-between">
          <span>Disk Space</span>
          <span class="text-danger">82%</span>
        </li>
        <li class="list-group-item bg-transparent d-flex justify-content-between">
          <span>Database</span>
          <span class="text-success">Connected</span>
        </li>
        <li class="list-group-item bg-transparent d-flex justify-content-between">
          <span>Redis Cache</span>
          <span class="text-success">Healthy</span>
        </li>
      </ul>
    </div>
  </div>

  <!-- Activity Summary -->
  <div class="col-lg-6">
    <div class="admin-panel">
      <h5 class="panel-title">Activity Summary</h5>

      <ul class="activity-list">
        <li>
          <span class="dot green"></span>
          New user registrations spiked
          <span class="time">Today</span>
        </li>
        <li>
          <span class="dot blue"></span>
          Blog publishing rate stable
          <span class="time">Last 24h</span>
        </li>
        <li>
          <span class="dot orange"></span>
          Minor latency increase detected
          <span class="time">2h ago</span>
        </li>
        <li>
          <span class="dot red"></span>
          Failed login attempts blocked
          <span class="time">Yesterday</span>
        </li>
      </ul>
    </div>
  </div>
</div>

<!-- Placeholder Charts -->
<div class="admin-panel mt-4">
  <h5 class="panel-title">Traffic & Usage Trends</h5>
  <div class="text-muted text-center py-5">
    📊 Charts will appear here (traffic, users, blogs, errors)
  </div>
</div>