<section class="mb-4">
  <h2 class="fw-semibold text-info mb-1">Admin Notes</h2>
  <p class="text-soft">
    Internal notes and coordination between administrators
  </p>
</section>

<div class="row g-3">
  <!-- Create Note -->
  <div class="col-lg-4">
    <div class="admin-panel panel-surface">
      <h5 class="panel-title">Create New Note</h5>

      <form method="POST" action="/admin/approvals">
        <div class="mb-3">
          <label class="form-label">Title</label>
          <input
            name="title"
            type="text"
            class="form-control"
            placeholder="e.g. Approve new category"
          />
        </div>

        <div class="mb-3">
          <label class="form-label">Priority</label>
          <select name="priority" class="form-select">
            <option value="normal">Normal</option>
            <option value="high">High</option>
            <option value="critical">Critical</option>
          </select>
          
        </div>

        <div class="mb-3">
          <label class="form-label">Note</label>
          <textarea
            name="body"
            class="form-control"
            rows="4"
            placeholder="Write details for other admins..."
          ></textarea>
        </div>

        <button type="button" class="btn btn-primary w-100">
          Post Note
        </button>
      </form>
    </div>
  </div>

  <!-- Notes Feed -->
  <div class="col-lg-8">
    <div class="admin-panel panel-surface">
      <h5 class="panel-title">Admin Notes</h5>

      <% notes.forEach(note => { %>
        <div class="admin-note <%= note.priority %>">
          <div class="note-header">
            <strong><%= note.title %></strong>

            <% if (note.priority === "critical") { %>
              <span class="badge bg-danger">Critical</span>
            <% } else if (note.priority === "high") { %>
              <span class="badge bg-warning text-dark">High</span>
            <% } else { %>
              <span class="badge bg-secondary">Normal</span>
            <% } %>
          </div>

          <p class="note-body">
            <%= note.body %>
          </p>

          <div class="note-footer">
            <span>
              Posted by <strong><%= note.createdBy?.username || "admin" %></strong>
            </span>

            <span>
              <%= new Date(note.createdAt).toLocaleString() %>
            </span>
          </div>

          <form
            method="POST"
            action="/admin/approvals/<%= note._id %>/delete"
            class="mt-2"
          >
            <button class="btn btn-sm btn-outline-danger">
              Delete
            </button>
          </form>
        </div>
      <% }) %>
    </div>
  </div>
</div>