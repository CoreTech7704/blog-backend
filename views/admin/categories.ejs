<section class="mb-4">
  <h2 class="fw-semibold text-info mb-1">Categories Management</h2>
  <p class="text-soft">
    Create and manage blog categories
  </p>
</section>

<div class="row g-3">
  <!-- Add Category -->
  <div class="col-lg-4">
    <div class="admin-panel panel-surface">
      <h5 class="panel-title">Add New Category</h5>

      <form>
        <div class="mb-3">
          <label class="form-label">Category Name</label>
          <input
            type="text"
            class="form-control"
            placeholder="e.g. Technology"
          />
        </div>

        <button type="button" class="btn btn-primary w-100">
          Add Category
        </button>
      </form>
    </div>
  </div>

  <!-- Categories List -->
  <div class="col-lg-8">
    <div class="admin-panel panel-surface">
      <h5 class="panel-title">Existing Categories</h5>

      <div class="table-responsive">
        <table class="table table-dark table-hover align-middle text-light">
          <thead>
            <tr>
              <th>#</th>
              <th>Name</th>
              <th>Slug</th>
              <th>Blogs</th>
              <th>Created</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>

          <tbody>
            <tr>
              <td>1</td>
              <td>Technology</td>
              <td class="text-soft">technology</td>
              <td>42</td>
              <td>12 Feb 2026</td>
              <td class="text-end">
                <button class="btn btn-sm btn-outline-danger">
                  Delete
                </button>
              </td>
            </tr>

            <tr>
              <td>2</td>
              <td>Design</td>
              <td class="text-soft">design</td>
              <td>18</td>
              <td>09 Feb 2026</td>
              <td class="text-end">
                <button class="btn btn-sm btn-outline-danger">
                  Delete
                </button>
              </td>
            </tr>

            <tr>
              <td>3</td>
              <td>Programming</td>
              <td class="text-soft">programming</td>
              <td>27</td>
              <td>05 Feb 2026</td>
              <td class="text-end">
                <button class="btn btn-sm btn-outline-danger">
                  Delete
                </button>
              </td>
            </tr>

            <tr>
              <td>4</td>
              <td>DevOps</td>
              <td class="text-soft">devops</td>
              <td>11</td>
              <td>01 Feb 2026</td>
              <td class="text-end">
                <button class="btn btn-sm btn-outline-danger">
                  Delete
                </button>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>