<section class="mb-4">
  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
      <h2 class="fw-semibold text-info mb-1">ADMIN CONTROL CENTER</h2>
      <p class="text-soft mb-0">
        Monitor platform activity and manage core operations
      </p>
    </div>

    <!-- Action buttons (only 2 as planned) -->
    <div class="d-flex gap-2">
      <a href="/admin/blogs" class="btn btn-primary">
        Feature Blog
      </a>

      <a href="/admin/contacts" class="btn btn-outline-primary">
        Review Reports
      </a>
    </div>
  </div>
</section>

<!-- Stats Cards -->
<div class="row g-3 mb-4">
  <div class="col-xl-3 col-md-6">
    <div class="admin-stat-card panel-surface">
      <div class="stat-label">Total Users</div>
      <div class="stat-value"><%= stats.totalUsers %></div>
      <div class="stat-meta">Active & inactive users</div>
    </div>
  </div>

  <div class="col-xl-3 col-md-6">
    <div class="admin-stat-card panel-surface">
      <div class="stat-label">Total Blogs</div>
      <div class="stat-value"><%= stats.totalBlogs %></div>
      <div class="stat-meta">Published & drafts</div>
    </div>
  </div>

  <div class="col-xl-3 col-md-6">
    <div class="admin-stat-card panel-surface">
      <div class="stat-label">Categories</div>
      <div class="stat-value"><%= stats.totalCategories %></div>
      <div class="stat-meta">Available blog categories</div>
    </div>
  </div>

  <div class="col-xl-3 col-md-6">
    <div class="admin-stat-card panel-surface">
      <div class="stat-label">Contact Reports</div>
      <div class="stat-value text-warning"><%= stats.unreadReports %></div>
      <div class="stat-meta">Unread messages</div>
    </div>
  </div>
</div>

<!-- Lower Sections -->
<div class="row g-3">
  <!-- Recent Activity -->
  <div class="col-lg-7">
    <div class="admin-panel panel-surface">
      <h5 class="panel-title">Recent Platform Activity</h5>

      <ul class="activity-list">
        <% activity.forEach(item => { %>
          <li>
            <span class="dot <%= item.color %>"></span>
            <%= item.message %>
            <span class="time">
              <%= new Date(item.time).toLocaleString() %>
            </span>
          </li>
        <% }) %>
      </ul>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="col-lg-5">
    <div class="admin-panel panel-surface">
      <h5 class="panel-title">Quick Admin Actions</h5>

      <div class="d-grid gap-2">
        <a href="/admin/blogs" class="btn btn-outline-primary">
          Review Pending Blogs
        </a>

        <a href="/admin/users" class="btn btn-outline-primary">
          Manage Users
        </a>

        <a href="/admin/contacts" class="btn btn-outline-warning">
          View Contact Reports
        </a>

        <a href="/admin/approvals" class="btn btn-outline-info">
          View Admin Notes
        </a>
      </div>
    </div>
  </div>
</div>
</div>